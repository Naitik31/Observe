aws_region      = "us-east-1"
cluster_name    = "my-eks-cluster"
cluster_version = "1.30"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4
node_capacity_type  = "ON_DEMAND"

tags = {
  ManagedBy   = "terraform"
  Project     = "eks-cluster"
  Environment = "dev"
}
